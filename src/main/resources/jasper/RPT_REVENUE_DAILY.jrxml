<?xml version="1.0" encoding="UTF-8"?>
<!-- Created with Jaspersoft Studio version 7.0.8.final using JasperReports Library version 7.0.8-6f896111  -->
<jasperReport name="RPT_REVENUE_DAILY" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="25" bottomMargin="25" uuid="e61b9a12-8821-4f01-9231-1a2b3c4d5e6f">
	<property name="net.sf.jasperreports.export.xlsx.detect.cell.type" value="true"/>
	<parameter name="fromDate" class="java.lang.String"/>
	<parameter name="toDate" class="java.lang.String"/>
	<parameter name="customerId" class="java.lang.Long"/>
	<parameter name="customerName" class="java.lang.String"/>
	<parameter name="dateRangeText" class="java.lang.String"/>
	<parameter name="exportTime" class="java.lang.String"/>
	<parameter name="minAmount" class="java.math.BigDecimal"/>
	<query language="sql"><![CDATA[
		WITH RECURSIVE date_series AS (
		    SELECT CAST($P{fromDate} AS DATE) AS report_date
		    UNION ALL
		    SELECT report_date + INTERVAL 1 DAY
		    FROM date_series
		    WHERE report_date < CAST($P{toDate} AS DATE)
		)
		SELECT 
		    ROW_NUMBER() OVER (ORDER BY ds.report_date) AS stt,
		    DATE_FORMAT(ds.report_date, '%d/%m/%Y') AS report_date_str,
		    COUNT(o.id) AS order_count,
		    COALESCE(SUM(o.total_amount), 0) AS total_revenue
		FROM date_series ds
		LEFT JOIN orders o ON 
		    DATE(DATE_ADD(o.paid_at, INTERVAL 7 HOUR)) = ds.report_date
		    AND o.status IN ('PAID', 'CONFIRMED', 'COMPLETED')
		    AND ($P{customerId} IS NULL OR o.customer_id = $P{customerId})
		    AND ($P{minAmount} IS NULL OR o.total_amount >= $P{minAmount})
		GROUP BY ds.report_date
		ORDER BY ds.report_date ASC
	]]></query>
	<field name="stt" class="java.lang.Long"/>
	<field name="report_date_str" class="java.lang.String"/>
	<field name="order_count" class="java.lang.Long"/>
	<field name="total_revenue" class="java.math.BigDecimal"/>
	<variable name="sumOrderCount" calculation="Sum" class="java.lang.Long">
		<expression><![CDATA[$F{order_count}]]></expression>
	</variable>
	<variable name="sumTotalRevenue" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{total_revenue}]]></expression>
	</variable>
